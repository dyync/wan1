# ---- HTTP ------------------------------------------------------------------
# Use HTTP_BIND=127.0.0.1 and an SSH tunnel if the instance has a public IP
# and you don't want the UI open to the internet.
HTTP_BIND=0.0.0.0
HTTP_PORT=8000

# ---- Hugging Face ----------------------------------------------------------
# Optional. The model is public; a token only raises download rate limits.
HF_TOKEN=
HF_REPO_ID=Wan-AI/Wan2.2-TI2V-5B

# ---- Queue / limits --------------------------------------------------------
JOB_QUEUE=wan:jobs
MAX_PENDING_JOBS=20
JOB_TTL_SECONDS=604800
JOB_TIMEOUT_SECONDS=3600

# ---- Inference -------------------------------------------------------------
# Leave empty to use the Wan2.2 config default (50 steps for ti2v-5B).
SAMPLE_STEPS=
LOG_LEVEL=INFO
